{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker só com arquivos estáticos (sem código de servidor). Plano gratuito.
  "name": "treino",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    // Rotas como /auth/callback devolvem o index.html do app.
    "not_found_handling": "single-page-application"
  }
}
